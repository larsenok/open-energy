  "devDependencies": {
    "eslint": "file:tools/stubs/eslint",
    "eslint-config-prettier": "file:tools/stubs/eslint-config-prettier",
    "eslint-plugin-prettier": "file:tools/stubs/eslint-plugin-prettier",
    "prettier": "file:tools/stubs/prettier",
    "vitest": "file:tools/stubs/vitest"
  }
}
